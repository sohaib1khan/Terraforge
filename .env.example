# Terraforge — copy to .env: cp .env.example .env

# --- Host ports (change these to avoid conflicts) ---
# Main UI / website (use this in the browser and for terraforge api-url / curl connect)
APP_PORT=3000
# Direct API bind on the host (optional; prefer APP_PORT via nginx proxy)
API_PORT=8088
# Optional DB/cache host ports
POSTGRES_PORT=5432
REDIS_PORT=6379

POSTGRES_USER=terraforge
POSTGRES_PASSWORD=terraforge
POSTGRES_DB=terraforge

JWT_SECRET=dev-only-change-me-terraforge-local
JWT_TTL=24h

# Optional 32-byte key (raw/hex/base64). If empty, derived from JWT_SECRET for local use.
SECRETS_KEY=

RUNNER_IMAGE=terraforge-runner:local
RUN_TIMEOUT_SECONDS=600
